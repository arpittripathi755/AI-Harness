# Daxiom Environment Configuration Template
# DO NOT commit real API keys or credentials to version control.

# Required: OpenRouter LLM API key
OPENROUTER_API_KEY=
# Or canonical alias:
AI_API_KEY=

# Optional: Default model identifier (default: deepseek/deepseek-v4.1-flash)
# Verified DeepSeek models: deepseek/deepseek-v4.1-flash, deepseek/deepseek-chat, deepseek/deepseek-v4-pro, deepseek/deepseek-v4-flash, deepseek/deepseek-r1
# Verified Qwen models:     qwen/qwen3-coder, qwen/qwen3-coder-plus, qwen/qwen3-coder-flash, qwen/qwen3.8-flash, qwen/qwen-2.5-72b-instruct, qwen/qwen-plus
MODEL=deepseek/deepseek-v4.1-flash

# Optional: Base URL for LLM provider (default: https://openrouter.ai/api/v1/)
BASE_URL=https://openrouter.ai/api/v1/

# Token Budget & Cost Controls (Adaptive Architecture)
# ----------------------------------------------------
# Optional: Hard ceiling on output tokens per completion request (default: 16384 legacy fallback, caps phase budgets)
# When set, this acts as a hard CEILING that lowers per-phase budgets (tool_decision: 1024, edit: 4096, explain: 1536, plan: 2048)
MAX_TOKENS=16384
# Alias for MAX_TOKENS:
AI_MAX_TOKENS=

# Optional: Maximum input context token budget before history compaction (default: 24000)
# When estimated input exceeds 70% of this budget, older tool results are compacted to stubs.
INPUT_TOKEN_BUDGET=24000

# Optional: Session budget limit in USD (default: unset / unlimited spend)
# Emits a system warning at 80% of budget and halts the agent loop gracefully at 100%.
MAX_SESSION_USD=

# Optional: Maximum allowed tool turns per user prompt (default: 25)
# Prevents run-away agent loops; agent stops with a clear summary of what was completed and what remains.
MAX_TOOL_TURNS=25

# Optional: Phase-based model routing override JSON map (default: empty / no overrides)
# Format: JSON string mapping CallPhase ("tool_decision" | "edit" | "explain" | "plan") to apiModelId.
# Example: PHASE_MODEL_OVERRIDE={"edit":"qwen/qwen-2.5-coder-32b-instruct","plan":"deepseek/deepseek-chat"}
PHASE_MODEL_OVERRIDE=


